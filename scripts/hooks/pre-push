#!/bin/sh
# Direct pushes to main may only touch README.md and TODO.md; everything else goes
# through a feature branch and PR. GitHub's ruleset can't scope its admin bypass by
# path, so this hook enforces the docs-only exception locally.
# Enable once per clone:  git config core.hooksPath scripts/hooks
#
# Every commit the push adds to main is checked on its own (merges against each
# parent), so a code change that a later commit reverts still counts. Any Git
# failure rejects the push: the hook fails closed.
zero=0000000000000000000000000000000000000000

fail() { echo "pre-push: $1" >&2; exit 1; }

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && fail "deleting main is not allowed"

  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha") || fail "cannot list commits of $local_sha"
  else
    git cat-file -e "$remote_sha^{commit}" 2>/dev/null ||
      fail "remote main ($remote_sha) is not in this clone; fetch first"
    commits=$(git rev-list "$remote_sha..$local_sha") || fail "cannot list $remote_sha..$local_sha"
  fi

  bad=""
  for c in $commits; do
    files=$(git diff-tree -r -m --root --no-commit-id --name-only "$c") ||
      fail "cannot read the changes in $c"
    hit=$(printf '%s\n' "$files" | grep -v -x -e README.md -e TODO.md -e '')
    [ -n "$hit" ] && bad="$bad$(printf '%s\n' "$hit" | sed "s/^/  $(git rev-parse --short "$c") /")
"
  done

  if [ -n "$bad" ]; then
    echo "pre-push: direct pushes to main may only change README.md or TODO.md." >&2
    echo "Use a feature branch and PR for:" >&2
    printf '%s' "$bad" | sort -u >&2
    exit 1
  fi
done
exit 0
